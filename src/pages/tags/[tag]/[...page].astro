---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { buildPaginationSeo } from "@/utils/paginationSeo";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;
const seo = buildPaginationSeo({
  title: `标签: ${tagName}`,
  description: `所有带有「${tagName}」标签的 yuyu 个人博客文章。`,
  canonicalBase: new URL(`/tags/${tag}/`, SITE.website),
  currentPage: page.currentPage,
  siteTitle: SITE.title,
});
---

<Layout
  title={seo.title}
  description={seo.description}
  pageType="collection"
  canonicalURL={seo.canonicalURL}
  breadcrumbs={[
    { name: "首页", url: SITE.website },
    { name: "标签", url: new URL("/tags/", SITE.website) },
    { name: tagName, url: Astro.url },
  ]}
>
  <Header />
  <Main
    pageTitle={[
      `标签:`,
      page.currentPage === 1
        ? `${tagName}`
        : `${tagName} · 第 ${page.currentPage} 页`,
    ]}
    titleTransition={tag}
    pageDesc={`所有带有「${tagName}」标签的文章`}
  >
    <h1 slot="title" transition:name={tag}>{`Tag:${tag}`}</h1>
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
