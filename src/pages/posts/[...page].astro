---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { buildPaginationSeo } from "@/utils/paginationSeo";
import { SITE } from "@/config";
import { TOPIC_HUBS } from "@/data/topicHubs";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const seo = buildPaginationSeo({
  title: "博客",
  description:
    "yuyu 关于 AI 账号店、AI 一人公司、AI 日报和 BioAI 生命延续学的文章归档。",
  canonicalBase: new URL("/posts/", SITE.website),
  currentPage: page.currentPage,
  siteTitle: SITE.title,
});
---

<Layout
  title={seo.title}
  description={seo.description}
  pageType="collection"
  canonicalURL={seo.canonicalURL}
  breadcrumbs={[
    { name: "首页", url: SITE.website },
    { name: "博客", url: new URL("/posts/", SITE.website) },
  ]}
>
  <Header />
  <Main
    pageTitle={page.currentPage === 1
      ? "博客"
      : `博客 · 第 ${page.currentPage} 页`}
    pageDesc="AI 工具、经营实践与生命科学观察，按发布时间排列。"
  >
    <nav aria-label="按主题阅读" class="archive-index">
      {
        TOPIC_HUBS.map(topic => (
          <a href={`/topics/${topic.slug}/`}>{topic.shortTitle}</a>
        ))
      }
      <a href="/rss.xml">RSS</a>
    </nav>
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
