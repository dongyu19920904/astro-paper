---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import TopicDetails from "@/layouts/TopicDetails.astro";
import { TOPIC_HUBS, type TopicHub } from "@/data/topicHubs";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPostTopicSlugs } from "@/utils/postTopics";
import { getTopicPage } from "@/utils/topicPagination";

export const getStaticPaths = (() =>
  TOPIC_HUBS.map(topic => ({
    params: { slug: topic.slug },
    props: { topic },
  }))) satisfies GetStaticPaths;
const { topic } = Astro.props as { topic: TopicHub };
const posts = getSortedPosts(await getCollection("blog")).filter(post =>
  getPostTopicSlugs(post).includes(topic.slug)
);
const page = getTopicPage(posts, topic.slug);
---

<TopicDetails {topic} {page} />
