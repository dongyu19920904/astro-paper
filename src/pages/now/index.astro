---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/layouts/Main.astro";
import knowledge from "@/data/authorKnowledge.json";
import { SITE } from "@/config";
---

<Layout title={`当前资料 | ${SITE.title}`} description={knowledge.summary}>
  <Header />
  <Main pageTitle="当前资料" pageDesc={knowledge.summary}>
    <p class="mb-8 text-sm text-foreground/75">
      资料核对至 <time datetime={knowledge.updatedAt}
        >{knowledge.updatedAt}</time
      >
      · <a href="/about/" class="underline underline-offset-4">关于 yuyu</a>
    </p>
    <section aria-labelledby="current-focus" class="mb-10">
      <h2 id="current-focus" class="mb-4 text-xl font-semibold">现在的重点</h2>
      {
        knowledge.currentFocus.map(item => (
          <article class="border-t border-border py-5">
            <h3 class="mb-2 font-semibold">
              {item.title}{" "}
              <span class="ml-2 text-sm font-normal text-foreground/75">
                {item.status}
              </span>
            </h3>
            <p class="leading-8 text-foreground/90">{item.text}</p>
          </article>
        ))
      }
    </section>
    <section aria-labelledby="recent-progress" class="mb-10">
      <h2 id="recent-progress" class="mb-4 text-xl font-semibold">近期进展</h2>
      <ol>
        {
          knowledge.milestones.map(item => (
            <li class="border-t border-border py-5">
              <p class="mb-2 text-sm text-foreground/75">
                <time datetime={item.date}>{item.date}</time> · {item.status}
              </p>
              <h3 class="mb-2 font-semibold">{item.title}</h3>
              <p class="leading-8 text-foreground/90">{item.text}</p>
              {item.links.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
                  {item.links.map(link => (
                    <li>
                      <a
                        href={link.url}
                        class="inline-block min-h-11 py-2 underline underline-offset-4 hover:text-accent"
                      >
                        {link.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </section>
    <section aria-labelledby="business-records" class="mb-10">
      <h2 id="business-records" class="mb-4 text-xl font-semibold">经营记录</h2>
      <ul class="list-disc space-y-3 pl-5 leading-8 text-foreground/90">
        {
          knowledge.publicFinancialStatements.map(item => (
            <li>{item.statement}</li>
          ))
        }
      </ul>
      <p class="mt-3 text-sm leading-7 text-foreground/75">
        本人自述，按原记录日期保留千、万级近似值。月收入不等于净利润，也不用于推算没有记录的每日收入。
      </p>
    </section>
    <section aria-labelledby="profile-boundaries" class="mb-8">
      <h2 id="profile-boundaries" class="mb-4 text-xl font-semibold">
        资料与边界
      </h2>
      <ul class="list-disc space-y-3 pl-5 leading-8 text-foreground/90">
        {knowledge.boundaries.map(item => <li>{item}</li>)}
      </ul>
    </section>
  </Main>
  <Footer />
</Layout>
