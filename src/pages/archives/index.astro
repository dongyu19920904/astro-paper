---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";

if (!SITE.showArchives) return Astro.redirect("/404");
const posts = getSortedPosts(await getCollection("blog"));
const dateFormat = new Intl.DateTimeFormat("zh-CN", {
  timeZone: SITE.timezone,
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
const groups = new Map<string, typeof posts>();
for (const post of posts) {
  const parts = dateFormat.formatToParts(post.data.pubDatetime);
  const part = (type: string) => parts.find(item => item.type === type)?.value;
  const key = `${part("year")}-${part("month")}`;
  groups.set(key, [...(groups.get(key) ?? []), post]);
}
---

<Layout
  title={`归档 | ${SITE.title}`}
  description="按月份查看 yuyu 个人博客的所有文章。"
  pageType="collection"
  canonicalURL={new URL("/archives/", SITE.website).href}
  breadcrumbs={[
    { name: "首页", url: SITE.website },
    { name: "归档", url: new URL("/archives/", SITE.website) },
  ]}
>
  <Header />
  <Main
    pageTitle="归档"
    pageDesc={`共 ${posts.length} 篇公开文章，按发布时间归档。`}
  >
    <nav class="archive-index" aria-label="按月份定位">
      {[...groups.keys()].map(month => <a href={`#month-${month}`}>{month}</a>)}
    </nav>
    {
      [...groups].map(([month, entries]) => (
        <section
          id={`month-${month}`}
          class="archive-month"
          aria-labelledby={`heading-${month}`}
        >
          <div class="flex items-center justify-between gap-2">
            <>
              <h2 id={`heading-${month}`} class="text-xl font-semibold">
                {month.slice(0, 4)} 年 {Number(month.slice(5))} 月
              </h2>
              <span class="text-sm text-foreground/80">
                {entries.length} 篇
              </span>
            </>
          </div>
          <ul class="mt-4">
            {entries.map(post => (
              <li class="archive-row">
                <time datetime={post.data.pubDatetime.toISOString()}>
                  {
                    dateFormat
                      .formatToParts(post.data.pubDatetime)
                      .find(part => part.type === "day")?.value
                  }{" "}
                  日
                </time>
                <a
                  href={getPath(post.id, post.filePath)}
                  class="hover:text-accent"
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </Main>
  <Footer />
</Layout>
