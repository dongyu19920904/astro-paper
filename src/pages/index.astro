---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { cleanPostDescription } from "@/utils/postDescription";
import { SITE } from "@/config";
import { HOME_PROJECTS } from "@/data/navProjects";
import { TOPIC_HUBS } from "@/data/topicHubs";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

const posts = getSortedPosts(await getCollection("blog")).slice(0, 3);
const topicDescriptions = [
  "让 AI 承担重复工作，保留人的判断与验收。",
  "整理研究来源，探索工具与可验证的项目。",
  "记录产品变化、客服效率与经营实践。",
];
function briefDescription(description: string, title: string) {
  const value = cleanPostDescription(
    description,
    title + "的个人观察与项目记录。"
  );
  const sentence = value.match(/^.*?[。！？]/u)?.[0] || value;
  return sentence.length > 88 ? sentence.slice(0, 88) + "…" : sentence;
}
---

<Layout
  pageType="website"
  title={SITE.title + " | AI 账号店、AI 一人公司与生命延续学实验"}
  description={SITE.desc}
  canonicalURL={SITE.website}
>
  <Header />
  <main id="main-content" data-layout="index" class="home app-layout">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">yuyu</h1>
      <p class="home-positioning">
        经营 AI 账号店，实践 AI 一人公司，探索 AI 生命延续学。
      </p>
      <p class="home-muted">这里记录我的项目、工具实践和长期观察。</p>
      <div class="home-actions">
        <a href="/projects/" class="home-primary"
          >看我的项目 <IconArrowRight /></a
        >
        <a href="/posts/">读文章 <IconArrowRight /></a>
        <a href={SITE.brand.website} target="_blank" rel="noopener noreferrer">
          爱窝啦·AI账号店 <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="home-topics" aria-label="长期关注的三个方向">
      {
        TOPIC_HUBS.map((topic, index) => (
          <a href={"/topics/" + topic.slug + "/"}>
            <h2>{topic.shortTitle}</h2>
            <p class="home-muted">{topicDescriptions[index]}</p>
          </a>
        ))
      }
    </section>

    <section class="home-section" aria-labelledby="home-projects-title">
      <div class="home-section-heading">
        <h2 id="home-projects-title">项目与实验</h2>
        <a href="/projects/">全部项目 <IconArrowRight /></a>
      </div>
      <div class="home-projects">
        {
          HOME_PROJECTS.map(project => (
            <article class="home-project">
              <p class="home-project-category">{project.tag}</p>
              <h3>
                <a
                  href={project.url}
                  target={project.url.startsWith("http") ? "_blank" : undefined}
                  rel={
                    project.url.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                >
                  {project.title}
                  <IconArrowRight />
                </a>
              </h3>
              <p class="home-muted">{project.desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    {
      posts.length > 0 && (
        <section class="home-section" aria-labelledby="home-posts-title">
          <div class="home-section-heading">
            <h2 id="home-posts-title">最近的记录</h2>
            <a href="/posts/">
              全部文章 <IconArrowRight />
            </a>
          </div>
          <ul class="home-posts">
            {posts.map(post => (
              <li>
                <h3>
                  <a href={getPath(post.id, post.filePath)}>
                    {post.data.title}
                  </a>
                </h3>
                <Datetime pubDatetime={post.data.pubDatetime} />
                <p class="home-muted">
                  {briefDescription(post.data.description, post.data.title)}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  /* Hallmark: personal editorial, introduction -> topics -> projects -> records.
     Reuses the site's existing colors and fonts; no new design dependencies. */
  .home {
    letter-spacing: 0;
  }
  .home-intro {
    padding-block: 2.5rem 2rem;
  }
  h1 {
    margin-bottom: 1rem;
    font-size: 2.75rem;
    font-weight: 650;
    line-height: 1.15;
  }
  .home-positioning {
    max-width: 36rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    line-height: 1.8;
  }
  .home-muted {
    color: var(--foreground);
    line-height: 1.8;
  }
  .home-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }
  .home-actions a,
  .home-section-heading a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
    white-space: nowrap;
  }
  .home-actions .home-primary {
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--accent);
    border-radius: 4px;
    font-weight: 600;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  .home-topics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--border);
  }
  .home-topics h2 {
    margin-bottom: 0.4rem;
    color: var(--accent);
    font-weight: 600;
  }
  .home-topics p {
    font-size: 0.875rem;
  }
  .home-section {
    padding-block: 2rem;
  }
  .home-section + .home-section {
    border-top: 1px solid var(--border);
  }
  .home-section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .home-section-heading h2 {
    font-size: 1.4rem;
    font-weight: 600;
  }
  .home-section-heading a {
    font-size: 0.875rem;
  }
  .home-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .home-project {
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .home-project-category {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }
  .home-project h3 {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
  .home-project h3 a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--accent);
  }
  .home-project p:last-child {
    font-size: 0.9375rem;
  }
  .home-posts li + li {
    margin-top: 1.25rem;
  }
  .home-posts h3 {
    margin-bottom: 0.3rem;
    color: var(--accent);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .home-posts p {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
  }
  .home :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }
  @media (max-width: 639px) {
    .home-intro {
      padding-block: 2rem 1.5rem;
    }
    .home-topics,
    .home-projects {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-topics {
      gap: 1rem;
    }
    .home-section {
      padding-block: 1.5rem;
    }
    .home-section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    if (document.querySelector('[data-layout="index"]')) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
