---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

/* ========== Formatted Datetime ========== */
const isModified = modDatetime && new Date(modDatetime) > new Date(pubDatetime);
const datetime = dayjs(pubDatetime).tz(postTimezone || SITE.timezone);

const date = datetime.format("YYYY-MM-DD");
const modified = isModified
  ? dayjs(modDatetime).tz(postTimezone || SITE.timezone)
  : null;
---

<div
  class:list={[
    "flex flex-wrap items-center gap-x-2 gap-y-1 text-sm",
    className,
  ]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={datetime.toISOString()}
    title="发布时间">{date}</time
  >
  {
    size === "lg" && modified && (
      <span>
        · 修订{" "}
        <time datetime={modified.toISOString()}>
          {modified.format("YYYY-MM-DD")}
        </time>
      </span>
    )
  }
</div>
