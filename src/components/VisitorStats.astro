---
import { SITE } from "@/config";
---

{
  SITE.analytics.la51WidgetUrl && (
    <div class="visitor-stats-panel" aria-label="51LA 访问统计">
      <script
        is:inline
        data-astro-rerun
        id="LA-DATA-WIDGET"
        crossorigin="anonymous"
        charset="UTF-8"
        src={SITE.analytics.la51WidgetUrl}
      />
    </div>
  )
}
<style>
  .visitor-stats-panel {
    width: 100%;
    min-width: 0;
    text-align: center;
  }
  .visitor-stats-panel :global(.la-widget) {
    display: flex !important;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    max-width: 100%;
    background: var(--background) !important;
    color: var(--foreground) !important;
  }
  .visitor-stats-panel :global(.la-widget span),
  .visitor-stats-panel :global(.la-widget p) {
    color: var(--foreground) !important;
  }
  .visitor-stats-panel :global(.la-widget > span) {
    display: inline-flex !important;
    align-items: baseline;
  }
</style>
<script>
  let widgetObserver: MutationObserver | undefined;
  function initWidgetTheme() {
    widgetObserver?.disconnect();
    const root = document.querySelector<HTMLElement>(".visitor-stats-panel");
    if (!root) return;
    function applyTheme() {
      // The provider's inline !important palette otherwise overrides site themes.
      for (const element of root!.querySelectorAll<HTMLElement>(
        ".la-widget, .la-widget span, .la-widget p"
      )) {
        element.style.removeProperty("color");
      }
      root!
        .querySelector<HTMLElement>(".la-widget")
        ?.style.removeProperty("background-color");
    }
    applyTheme();
    widgetObserver = new MutationObserver(applyTheme);
    widgetObserver.observe(root, { childList: true, subtree: true });
  }
  initWidgetTheme();
  document.addEventListener("astro:page-load", initWidgetTheme);
  document.addEventListener("astro:before-swap", () =>
    widgetObserver?.disconnect()
  );
</script>
