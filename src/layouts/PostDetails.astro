---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import ArticleSeries from "@/components/ArticleSeries.astro";
import { getPath } from "@/utils/getPath";
import { cleanPostDescription } from "@/utils/postDescription";
import { scoreRelatedPost } from "@/utils/postTopics";
import {
  estimateReadingMinutes,
  isAutomatedArticle,
} from "@/utils/articleReading";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};
const { post, posts } = Astro.props;
const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const toc = headings.filter(heading => heading.depth === 2);
const citations = Array.isArray(remarkPluginFrontmatter.articleSources)
  ? (remarkPluginFrontmatter.articleSources as string[])
  : [];
const displayDescription = cleanPostDescription(
  description,
  `${title} 的个人观察与项目记录。`
);
let ogImageUrl: string | undefined;
if (typeof initOgImage === "string") ogImageUrl = initOgImage;
else if (initOgImage?.src) ogImageUrl = initOgImage.src;
if (!ogImageUrl && SITE.dynamicOgImage)
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
const articleCanonicalURL = new URL(
  canonicalURL || getPath(post.id, post.filePath),
  SITE.website
).href;
const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description: displayDescription,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  pageType: "article" as const,
  keywords: tags,
  citations,
  breadcrumbs: [
    { name: "首页", url: SITE.website },
    { name: "博客", url: new URL("/posts/", SITE.website) },
    { name: title, url: articleCanonicalURL },
  ],
  scrollSmooth: true,
};
const currentPostIndex = posts.findIndex(candidate => candidate.id === post.id);
const prevPost = currentPostIndex > 0 ? posts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex >= 0 && currentPostIndex + 1 < posts.length
    ? posts[currentPostIndex + 1]
    : null;
const relatedPosts = posts
  .filter(candidate => candidate.id !== post.id)
  .map(candidate => ({ candidate, score: scoreRelatedPost(post, candidate) }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score)
  .map(({ candidate }) => candidate)
  .slice(0, 3);
const displayPosts = relatedPosts.length
  ? relatedPosts
  : posts.filter(candidate => candidate.id !== post.id).slice(0, 3);
const automated = isAutomatedArticle(tags);
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={[
      "article-layout app-layout pb-12",
      { "mt-8": !SITE.showBackButton },
    ]}
  >
    <h1
      transition:name={slugifyStr(title)}
      class="article-title"
      data-pagefind-meta="title"
    >
      {title}
    </h1>
    <div class="article-byline" data-pagefind-ignore>
      <a href="/about/" rel="author">{author}</a>
      <ArticleSeries {tags} />
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span>约 {estimateReadingMinutes(post.body ?? "")} 分钟</span>
      <EditPost {hideEditPost} {post} />
    </div>
    {
      automated && (
        <div class="article-method" data-pagefind-ignore>
          <p>
            AI 辅助自动整理 ·
            未记录逐篇人工核验。时效信息与具体经历请结合原始来源核对。
          </p>
          {tags.includes("bioai-daily") && (
            <p>研究信息不等于人体效果，不作为诊断、治疗或个人干预依据。</p>
          )}
        </div>
      )
    }
    {
      toc.length >= 4 && (
        <details class="article-toc" data-pagefind-ignore>
          <summary>本文目录 · {toc.length} 节</summary>
          <ol>
            {toc.map(heading => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }
    <article
      id="article"
      data-pagefind-body
      class="app-prose mt-8 w-full prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>
    <aside
      class="article-citation"
      aria-label="引用与内容边界"
      data-pagefind-ignore
    >
      <p>
        规范引用：{author}，《{title}》，{
          pubDatetime.toLocaleDateString("zh-CN", { timeZone: SITE.timezone })
        }。<a href={articleCanonicalURL}>文章原地址</a>
      </p>
      <p>
        个人观察与资料整理，不构成医疗、投资建议或平台服务承诺。<a
          href="/ai-citation.md">引用说明</a
        > · <a href="/llms.txt">llms.txt</a>
      </p>
    </aside>
    <ul class="my-6 flex flex-wrap gap-4" data-pagefind-ignore>
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>
    {
      displayPosts.length > 0 && (
        <section class="my-8" data-pagefind-ignore>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-lg font-semibold">
              {relatedPosts.length ? "延伸阅读" : "最近发布"}
            </h2>
            <a
              href="/posts/"
              class="inline-flex min-h-11 items-center text-sm text-accent"
            >
              全部文章
            </a>
          </div>
          <ul>
            {displayPosts.map(item => (
              <li class="post-list-item">
                <a
                  class="post-list-title font-medium hover:text-accent"
                  href={getPath(item.id, item.filePath)}
                >
                  {item.data.title}
                </a>
                <div class="post-list-meta">
                  <ArticleSeries tags={item.data.tags} />
                  <Datetime pubDatetime={item.data.pubDatetime} />
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <ShareLinks />
    <nav
      aria-label="前后文章"
      data-pagefind-ignore
      class="mt-6 grid grid-cols-1 gap-6 border-t border-border pt-6 sm:grid-cols-2"
    >
      {
        prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="flex min-h-11 w-full gap-1 hover:text-accent"
          >
            <>
              <IconChevronLeft class="size-6 flex-none" />
              <div>
                <>
                  <span class="text-sm">上一篇</span>
                  <div>{prevPost.data.title}</div>
                </>
              </div>
            </>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="flex min-h-11 w-full justify-end gap-1 text-end hover:text-accent sm:col-start-2"
          >
            <>
              <div>
                <>
                  <span class="text-sm">下一篇</span>
                  <div>{nextPost.data.title}</div>
                </>
              </div>
              <IconChevronRight class="size-6 flex-none" />
            </>
          </a>
        )
      }
    </nav>
    <a
      href="#main-content"
      class="mt-6 inline-flex min-h-11 items-center text-sm text-accent"
      data-pagefind-ignore>返回顶部</a
    >
  </main>
  <Footer />
</Layout>
<script>
  import "@/scripts/articleReader";
</script>
